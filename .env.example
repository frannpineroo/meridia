# Copiá este archivo a .env.local. Nunca subas .env.local al repo.

# Credencial del modelo vía Vercel AI Gateway (no necesaria si usás `/login` en `npm exec -- eve dev`
# o si el proyecto está vinculado a Vercel con OIDC).
AI_GATEWAY_API_KEY=

# Contraseña compartida de la demo (Basic Auth en proxy.ts y en agent/channels/eve.ts).
# Sin estas dos variables, producción rechaza todo. En local, sin ellas la app queda abierta.
DEMO_USERNAME=
DEMO_PASSWORD=
